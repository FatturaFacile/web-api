{
  "uid": "ff-queue-workers",
  "title": "FatturaFacile — Queue Workers & Scheduled Jobs",
  "tags": ["fatturafacile", "queue", "scheduler"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Jobs waiting (all queues)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 100 }, { "color": "red", "value": 1000 }] } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(fatturafacile_queue_depth) or vector(0)" }]
    },
    {
      "id": 2, "type": "stat", "title": "Throughput (jobs/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(rate(fatturafacile_queue_jobs_total{status=\"processed\"}[5m])) or vector(0)" }]
    },
    {
      "id": 3, "type": "stat", "title": "Failed jobs (last hour)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 20 }] } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(increase(fatturafacile_queue_jobs_total{status=\"failed\"}[1h])) or vector(0)" }]
    },
    {
      "id": 4, "type": "stat", "title": "Queue lag p95 (wait before start)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 30 }, { "color": "red", "value": 120 }] } }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(fatturafacile_queue_wait_seconds_bucket[5m])))" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Queue depth (retry and backlog)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "fatturafacile_queue_depth", "legendFormat": "{{connection}}:{{queue}}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Throughput by queue",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (queue, status) (rate(fatturafacile_queue_jobs_total[5m]))", "legendFormat": "{{queue}} {{status}}" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Queue lag p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(fatturafacile_queue_wait_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(fatturafacile_queue_wait_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(fatturafacile_queue_wait_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Job duration p95 by job",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "topk(10, histogram_quantile(0.95, sum by (le, job) (rate(fatturafacile_queue_job_duration_seconds_bucket[15m]))))", "legendFormat": "{{job}}" }]
    },
    {
      "id": 9, "type": "table", "title": "Failed jobs by class (last 24 h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "options": { "showHeader": true },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "failures" } } }],
      "targets": [{ "refId": "A", "instant": true, "format": "table", "expr": "sort_desc(sum by (queue, job) (increase(fatturafacile_queue_jobs_total{status=\"failed\"}[24h])) > 0)" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "Scheduled jobs: connector probes and other scheduler work (runs per 10 min)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (job, status) (increase(fatturafacile_queue_jobs_total{job=~\"ProbeConnectorJob|.*Sync.*Job|.*Revenue.*|.*Scheduled.*\"}[10m]))", "legendFormat": "{{job}} {{status}}" }]
    }
  ]
}
