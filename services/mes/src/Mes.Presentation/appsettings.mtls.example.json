{
  "_comment": "Production mTLS example. Merge into appsettings.Production.json. Kestrel must REQUEST the client certificate; the Gateway policy then validates the chain and maps the thumbprint to a tenant.",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:8443",
        "ClientCertificateMode": "AllowCertificate",
        "Certificate": { "Path": "/etc/mes/server.pfx", "Password": "from-secret-store" }
      }
    }
  },
  "Auth": {
    "Mode": "Certificate",
    "Certificate": {
      "RevocationMode": "Online",
      "Gateways": [
        { "Thumbprint": "AB12CD34EF56...", "TenantId": "00000000-0000-0000-0000-000000000000", "GatewayId": "line-1-cell-2" }
      ]
    }
  }
}
