    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php scripts/dev/locked.php php -d memory_limit=1536M artisan test --parallel --processes=6"
        ],
        "test:serial": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php scripts/dev/locked.php php artisan test"
        ],
        "test:unit": "@php scripts/dev/locked.php php -d memory_limit=1536M vendor/bin/pest --parallel --processes=6 --no-coverage --testsuite=Unit",
        "test:arch": "@php scripts/dev/locked.php php -d memory_limit=1536M vendor/bin/pest --no-coverage --testsuite=Architecture",
        "test:fast": "@php scripts/dev/locked.php php -d memory_limit=1536M vendor/bin/pest --parallel --processes=6 --no-coverage --testsuite=Unit,Architecture",
        "test:changed": "@php scripts/dev/locked.php php -d memory_limit=1536M vendor/bin/pest --parallel --processes=4 --no-coverage --dirty",
        "test:module": "@php scripts/dev/locked.php php -d memory_limit=1536M vendor/bin/pest --parallel --processes=4 --no-coverage",
        "lint": "@php vendor/bin/pint --test",
        "lint:dirty": "@php vendor/bin/pint --dirty",
        "analyse": "@php -d memory_limit=2G vendor/bin/phpstan analyse --memory-limit=2G",
        "analyse:dirty": "@php scripts/dev/analyse-dirty.php",
        "quality": [
            "@lint",
            "@analyse",
            "@test:arch"
        ],
        "quality:full": [
            "@quality",
            "@test"
        ],
        "test:sail": [
            "./vendor/bin/sail test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "git config core.hooksPath .githooks || true"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "process-timeout": 0,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
