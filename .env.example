APP_NAME=FatturaFacile
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

FRONTEND_URL=https://localhost:4200
SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200,localhost,127.0.0.1,dev-api.fatturafacile.eu
CORS_ALLOWED_ORIGINS=https://localhost:4200,https://demo.fatturafacile.eu

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL configuration (e.g. for CI / local test reproduction with .env.testing)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=fatturafacile_test
# DB_USERNAME=test_user
# DB_PASSWORD=secret_password

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS=
# Mailpit in local (docker compose -f docker-compose.local.yml up -d, inbox on http://localhost:8025):
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# The emails go on the queue: run `php artisan queue:work` as well.

AUTH_VERIFICATION_EXPIRES_MINUTES=1440
AUTH_PRUNE_UNVERIFIED_AFTER_DAYS=7
AUTH_REGISTER_PER_EMAIL_PER_HOUR=3
AUTH_PASSWORD_RESET_EXPIRES_MINUTES=60
AUTH_PASSWORD_RESET_PRUNE_AFTER_DAYS=7
AUTH_PASSWORD_RESET_MAX_FAILED_ATTEMPTS=10
AUTH_PASSWORD_RESET_LOCKOUT_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_PASSWORD_MIXED_CASE=true
AUTH_PASSWORD_NUMBERS=true
AUTH_PASSWORD_SYMBOLS=true
AUTH_TWO_FACTOR_CHALLENGE_TTL_MINUTES=5
AUTH_TWO_FACTOR_MAX_CHALLENGE_ATTEMPTS=5
AUTH_TWO_FACTOR_RECOVERY_CODES=8
AUTH_TWO_FACTOR_CHALLENGE_PER_MINUTE=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SDI channel for tenants without their own: pec, openapi, acube, invoicetronic, local. Empty blocks transmission.
SDI_DEFAULT_CHANNEL=local

# Every authenticated route requires tenant_id and user_id. Set to false only for old clients during a migration.
TENANCY_REQUIRE_REQUEST_CONTEXT=true
L5_SWAGGER_GENERATE_ALWAYS=true

# Swiss customs: every live transmission needs CUSTOMS_EDEC_LIVE_TRANSMISSION=true, an https endpoint and a client certificate.
CUSTOMS_DEFAULT_CHANNEL=local
CUSTOMS_ARCHIVE_DISK=private
CUSTOMS_EDEC_LIVE_TRANSMISSION=false
CUSTOMS_EDEC_DECLARATION_ENDPOINT=
CUSTOMS_EDEC_RECEIPT_ENDPOINT=
CUSTOMS_EDEC_CLIENT_CERTIFICATE=
CUSTOMS_EDEC_CLIENT_KEY=
CUSTOMS_EDEC_CLIENT_KEY_PASSPHRASE=

# Hosts (comma separated, *.suffix allowed) that outbound calls may reach even on private addresses: honoured only with APP_ENV=local.
OUTBOUND_ALLOWED_HOSTS=
