# Copy to deploy/local/.env (cp deploy/local/env.example deploy/local/.env). Local trial only: change the password if you like.
APP_NAME=FatturaFacile
APP_URL=https://localhost:8080
FRONTEND_URL=https://localhost:4200
SESSION_SECURE_COOKIE=true
# Leave empty: a key is generated on first start and kept in the storage volume.
APP_KEY=
API_PORT=8080

DB_DATABASE=fatturafacile
DB_USERNAME=fatturafacile
DB_PASSWORD=change-me-local
