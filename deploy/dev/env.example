# Copy to ~/fatturafacile-dev/.env on the VPS (chmod 600) and fill in the values. Never commit the real file.
APP_NAME=FatturaFacileDev
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://dev-api.fatturafacile.eu
FRONTEND_URL=https://dev.fatturafacile.eu
SANCTUM_STATEFUL_DOMAINS=dev.fatturafacile.eu,inglorious.fatturafacile.eu,localhost:4200,127.0.0.1:4200
CORS_ALLOWED_ORIGINS=https://dev.fatturafacile.eu
SESSION_DRIVER=database
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
LOG_CHANNEL=stderr
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ffdev
DB_USERNAME=ffdev
DB_PASSWORD=
CACHE_STORE=database
QUEUE_CONNECTION=database
# Above the longest job timeout (900 s, tenant backups); the worker runs with --timeout=900.
DB_QUEUE_RETRY_AFTER=960
MAIL_MAILER=log
# Dev is wiped and reseeded on every deploy and every 30 minutes (demo:reset)
DEMO_RESET_ENABLED=true
# Telescope tables are not migrated: keep it off, as in production
TELESCOPE_ENABLED=false
