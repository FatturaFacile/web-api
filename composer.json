{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "darkaonline/l5-swagger": "^11.2",
        "dedoc/scramble": "^0.13.49",
        "endroid/qr-code": "^6.1",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.0",
        "laravel/telescope": "^5.26",
        "laravel/tinker": "^3.0",
        "onelogin/php-saml": "^4.4",
        "openspout/openspout": "^5.13",
        "picqer/php-barcode-generator": "^3.3",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-query-builder": "^7.3",
        "sprain/swiss-qr-bill": "^5.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.14",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.69",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Enterprise\\Foundation\\": "packages/enterprise-foundation/src/",
            "Enterprise\\AuditLedger\\": "packages/audit-ledger/src/",
            "Enterprise\\AiGateway\\": "packages/ai-gateway/src/",
            "Enterprise\\EventBus\\": "packages/event-bus/src/",
            "Enterprise\\MultiTenant\\": "packages/multi-tenant/src/",
            "Enterprise\\FeatureFlags\\": "packages/feature-flags/src/",
            "Enterprise\\OpenApi\\": "packages/openapi/src/",
            "Modules\\SDI\\": "modules/06_SDI/src/",
            "Modules\\Workflow\\": "modules/21_Workflow/src/",
            "Modules\\Procurement\\": "modules/13_Procurement/src/",
            "Modules\\Inventory\\": "modules/14_Inventory/src/",
            "Modules\\Projects\\": "modules/15_Projects/src/",
            "Modules\\GeneralLedger\\": "modules/22_GeneralLedger/src/",
            "Modules\\Treasury\\": "modules/24_Treasury/src/",
            "Modules\\Invoicing\\": "modules/05_Invoicing/src/",
            "Modules\\CRM\\": "modules/02_CRM/src/",
            "Modules\\AssetManagement\\": "modules/16_AssetManagement/src/",
            "Modules\\HumanResources\\": "modules/18_HumanResources/src/",
            "Modules\\ServiceManagement\\": "modules/17_ServiceManagement/src/",
            "Modules\\SubscriptionBilling\\": "modules/19_SubscriptionBilling/src/",
            "Modules\\Manufacturing\\": "modules/30_Manufacturing/src/",
            "Modules\\Analytics\\": "modules/20_Analytics/src/",
            "Modules\\Communication\\": "modules/23_Communication/src/",
            "Modules\\FiscalRetail\\": "modules/26_FiscalRetail/src/",
            "Modules\\HealthExpenses\\": "modules/27_HealthExpenses/src/",
            "Modules\\DataExport\\": "modules/28_DataExport/src/",
            "Modules\\Integrations\\": "modules/29_Integrations/src/",
            "Modules\\DocumentTrust\\": "modules/32_DocumentTrust/src/",
            "Modules\\Payroll\\": "modules/18_Payroll/src/",
            "Modules\\Associations\\": "modules/31_Associations/src/",
            "Modules\\Customs\\": "modules/32_Customs/src/",
            "Modules\\Documents\\": "modules/25_Documents/src/",
            "Modules\\Contracts\\": "modules/26_Contracts/src/",
            "Modules\\Assistant\\": "modules/27_Assistant/src/",
            "Modules\\EDocumentNetworks\\": "modules/28_EDocumentNetworks/src/",
            "Modules\\WorkspaceSync\\": "modules/29_WorkspaceSync/src/",
            "Modules\\Workshop\\": "modules/33_Workshop/src/",
            "Modules\\ConstructionTrades\\": "modules/34_ConstructionTrades/src/",
            "Modules\\Childcare\\": "modules/35_Childcare/src/",
            "Modules\\PracticeManagement\\": "modules/36_PracticeManagement/src/",
            "Modules\\Hospitality\\": "modules/37_Hospitality/src/",
            "Modules\\Visitors\\": "modules/38_Visitors/src/",
            "Modules\\Intrastat\\": "modules/39_Intrastat/src/",
            "Modules\\Quality\\": "modules/40_Quality/src/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "test:pg": [
            "docker compose -f docker-compose.test.yml up -d --wait postgres-test",
            "@php artisan migrate:fresh --env=testing --force",
            "./vendor/bin/pest",
            "docker compose -f docker-compose.test.yml down"
        ],
        "test:sail": [
            "./vendor/bin/sail test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "git config core.hooksPath .githooks || true"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
