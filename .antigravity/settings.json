{
  "compactThresholdPercent": 50,
  "maxBashOutputChars": 15000,
  "permissions": {
    "deny": [
      "Read(./**/vendor/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/storage/logs/**)",
      "Read(./**/storage/framework/**)",
      "Read(./**/public/build/**)",
      "Read(./**/*.lock)",
      "Read(./**/*-lock.*)",
      "Read(./**/.env*)",
      "Read(./**/auth.json)"
    ]
  }
}
