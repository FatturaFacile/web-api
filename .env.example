APP_NAME=FatturaFacile
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

FRONTEND_URL=https://localhost:4200
SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200,localhost,127.0.0.1,dev-api.fatturafacile.eu
CORS_ALLOWED_ORIGINS=https://localhost:4200,https://demo.fatturafacile.eu

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL configuration (e.g. for CI / local test reproduction with .env.testing)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=fatturafacile_test
# DB_USERNAME=test_user
# DB_PASSWORD=secret_password

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=__Host-fatturafacile_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production (docker-compose.yml) runs the worker on Redis: set QUEUE_CONNECTION=redis there, or jobs wait in the
# database queue that no worker reads. database is fine for local development without Redis.
QUEUE_CONNECTION=redis
# Above the longest job timeout (900 s, tenant backups); the worker runs with --timeout=900.
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# Production (docker-compose.yml): REDIS_PASSWORD and DB_PASSWORD are mandatory, the stack does not start without them.
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS=
# Mailpit in local (docker compose -f docker-compose.local.yml up -d, inbox on https://localhost:8025):
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# The emails go on the queue: run `php artisan queue:work` as well.

AUTH_VERIFICATION_EXPIRES_MINUTES=1440
AUTH_PRUNE_UNVERIFIED_AFTER_DAYS=7
AUTH_REGISTER_PER_EMAIL_PER_HOUR=3
AUTH_PASSWORD_RESET_EXPIRES_MINUTES=60
AUTH_PASSWORD_RESET_PRUNE_AFTER_DAYS=7
AUTH_PASSWORD_RESET_MAX_FAILED_ATTEMPTS=10
AUTH_PASSWORD_RESET_LOCKOUT_MINUTES=15
AUTH_PASSWORD_CHANGE_MAX_FAILED_ATTEMPTS=5
AUTH_PASSWORD_CHANGE_LOCKOUT_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_PASSWORD_MIXED_CASE=true
AUTH_PASSWORD_NUMBERS=true
AUTH_PASSWORD_SYMBOLS=true
AUTH_TWO_FACTOR_CHALLENGE_TTL_MINUTES=5
AUTH_TWO_FACTOR_MAX_CHALLENGE_ATTEMPTS=5
AUTH_TWO_FACTOR_RECOVERY_CODES=8
AUTH_TWO_FACTOR_CHALLENGE_PER_MINUTE=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SDI channel for tenants without their own: pec, openapi, acube, invoicetronic, local. Empty blocks transmission.
SDI_DEFAULT_CHANNEL=local

# Every authenticated route requires tenant_id and user_id. Set to false only for old clients during a migration.
TENANCY_REQUIRE_REQUEST_CONTEXT=true
L5_SWAGGER_GENERATE_ALWAYS=true

# Swiss customs: every live transmission needs CUSTOMS_EDEC_LIVE_TRANSMISSION=true, an https endpoint and a client certificate.
CUSTOMS_DEFAULT_CHANNEL=local
CUSTOMS_ARCHIVE_DISK=private
CUSTOMS_EDEC_LIVE_TRANSMISSION=false
CUSTOMS_EDEC_DECLARATION_ENDPOINT=
CUSTOMS_EDEC_RECEIPT_ENDPOINT=
CUSTOMS_EDEC_CLIENT_CERTIFICATE=
CUSTOMS_EDEC_CLIENT_KEY=
CUSTOMS_EDEC_CLIENT_KEY_PASSPHRASE=

# Hosts (comma separated, *.suffix allowed) that outbound calls may reach even on private addresses: honoured only with APP_ENV=local.
OUTBOUND_ALLOWED_HOSTS=
# AI: extraction and assistant stay on the local driver; the enterprise gateway drivers below need keys to be used.
AI_EXTRACTION_DRIVER=local
AI_ASSISTANT_DRIVER=local
AI_DEFAULT_DRIVER=ollama
AI_FALLBACK_DRIVER=ollama
OLLAMA_BASE_URL=https://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Appointment reminders: minutes before the start when the reminder is mailed.
APPOINTMENT_REMINDER_LEAD_MINUTES=1440
# Subscription billing module: schedule the billing run and revenue recognition (manual by default).
SUBSCRIPTION_BILLING_SCHEDULED=false

# --- Optional values (defaults in config/*.php); real values only in the server .env, never in the repository ---
# Public API docs (Swagger): by default they need a login in production.
# DOCS_ENABLED=true
# DOCS_REQUIRE_AUTH=true
# DOCS_ALLOWED_EMAILS=
# APP_RELEASE=1.0.0
# SANCTUM_EXPIRATION=720
# HTTPS only (every environment): no switch to turn it off. HSTS and the optional bearer token mode:
# SECURITY_HSTS_MAX_AGE=31536000
# SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
# SECURITY_HSTS_PRELOAD=false
# SECURITY_HTTP_ALLOWED_PATHS=up
# AUTH_TOKEN_MODE_ENABLED=false
# AUTH_SSO_EXCHANGE_TTL_SECONDS=60
# DEMO_RESET_ENABLED=false
# BACKUP_DISK=private
# BACKUP_FILES_DISK=local
# BACKUP_RETENTION=7
# BACKUP_SAFETY_RETENTION=3

# --- Secrets and integrations: leave unset to keep the feature off (an empty value is not the same as unset) ---
# SDI_WEBHOOK_SECRET=
# BOOTSTRAP_SUPPORT_SECRET=
# ASSOCIATIONS_PAYMENT_DRIVER=local
# ASSOCIATIONS_PAYMENT_SECRET_KEY=
# ASSOCIATIONS_PAYMENT_WEBHOOK_SECRET=
# WORKSPACE_REDIRECT_URI=
# GOOGLE_WORKSPACE_CLIENT_ID=
# GOOGLE_WORKSPACE_CLIENT_SECRET=
# MICROSOFT_365_CLIENT_ID=
# MICROSOFT_365_CLIENT_SECRET=
# POSTMARK_API_KEY=
# RESEND_API_KEY=
