#!/bin/sh
# Regenerates the OpenAPI/Postman files before every push. A push cannot carry a commit created inside the hook,
# so when the regenerated files differ from the committed ones the push is aborted: commit them and push again.

[ "${SKIP_SWAGGER_HOOK:-0}" = "1" ] && exit 0

echo "Regenerating the OpenAPI specification (docs/api)..."
if ! php -d memory_limit=2048M artisan docs:export; then
    echo "OpenAPI export failed: push aborted." >&2
    exit 1
fi

if ! git diff --quiet -- docs/api; then
    echo "docs/api changed after regeneration. Commit it, then push again:" >&2
    echo "  git add docs/api && git commit -m \"docs: regenerate OpenAPI\"" >&2
    exit 1
fi

exit 0
